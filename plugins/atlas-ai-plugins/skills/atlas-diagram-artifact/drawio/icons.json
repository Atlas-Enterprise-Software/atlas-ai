{
  "id": "azure",
  "note": "Style strings verified against the draw.io shape library. azure2 relative paths match the team's hand-made diagrams under cb.Diagrams.net; the absolute icons.diagrams.net URLs cover products with no azure2 stencil. First match wins, and the runtime rules come first: a node that declares itself a Function App, App Service or Container App reads as that runtime even when its name mentions a product it serves (Cb.Iris.UI.SignalR is a Function App, not the SignalR service). Matched against a node's label, plus its sublabel when the node is infrastructure (database/messagebus/cloud) — a backend that says \"Cosmos + Blob\" names the stores it uses, it is not one. A rule with scope \"any\" also matches a sublabel on any node: it names a runtime the node IS, never a resource it merely uses.",
  "icons": [
    {
      "match": "(function\\s*app|durable\\s*functions|azure\\s*functions)",
      "url": "img/lib/azure2/compute/Function_Apps.svg",
      "title": "Function App",
      "scope": "any"
    },
    {
      "match": "app\\s*service",
      "url": "img/lib/azure2/containers/App_Services.svg",
      "title": "App Service",
      "scope": "any"
    },
    {
      "match": "(container\\s*app|keda)",
      "url": "img/lib/azure2/other/Container_App_Environments.svg",
      "title": "Container App",
      "scope": "any"
    },
    {
      "match": "\\bsignalr\\b",
      "url": "https://icons.diagrams.net/assets/azure/1/Azure_SignalIR.svg",
      "title": "Azure SignalR"
    },
    {
      "match": "event\\s*grid",
      "url": "img/lib/azure2/integration/Event_Grid_Topics.svg",
      "title": "Event Grid Topics"
    },
    {
      "match": "service\\s*bus",
      "url": "https://icons.diagrams.net/assets/azure/1/Azure_Service_Bus_Queues.svg",
      "title": "Service Bus"
    },
    {
      "match": "cosmos",
      "url": "img/lib/azure2/databases/Azure_Cosmos_DB.svg",
      "title": "Cosmos DB"
    },
    {
      "match": "blob",
      "url": "img/lib/azure2/general/Storage_Container.svg",
      "title": "Blob Storage"
    },
    {
      "match": "(storage\\s*queue|queue\\s*storage)",
      "url": "img/lib/azure2/general/Storage_Queue.svg",
      "title": "Queue Storage"
    },
    {
      "match": "(sql\\s*server|sql\\s*database|azure\\s*sql)",
      "url": "https://icons.diagrams.net/assets/azure/1/SQL_Database.svg",
      "title": "SQL Database"
    },
    {
      "match": "(redis|azure\\s*cache)",
      "url": "https://app.diagrams.net/img/lib/mscae/Azure_Cache_for_Redis.svg",
      "title": "Cache for Redis"
    },
    {
      "match": "key\\s*vault",
      "url": "https://icons.diagrams.net/assets/azure/1/Key_Vault.svg",
      "title": "Key Vault"
    },
    {
      "match": "app\\s*configuration",
      "url": "img/lib/azure2/integration/App_Configuration.svg",
      "title": "App Configuration"
    },
    {
      "match": "application\\s*insights",
      "url": "img/lib/azure2/management_governance/Application_Insights.svg",
      "title": "Application Insights"
    },
    {
      "match": "(entra|active\\s*directory|azure\\s*ad\\b)",
      "url": "https://app.diagrams.net/img/lib/azure2/identity/Azure_Active_Directory.svg",
      "title": "Microsoft Entra ID"
    },
    {
      "match": "(ai\\s*search|azure\\s*search|cognitive\\s*search)",
      "url": "https://app.diagrams.net/img/lib/mscae/Search.svg",
      "title": "Azure Search"
    },
    {
      "match": "api\\s*management",
      "url": "img/lib/azure2/app_services/API_Management_Services.svg",
      "title": "API Management",
      "scope": "any"
    },
    {
      "match": "(document\\s*intelligence|form\\s*recognizer|cognitive\\s*services)",
